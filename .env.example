# Copy to .env and fill in. See README.md for details.
BLB_HOST=
BLB_PORT=3306
BLB_USER=
BLB_PASSWORD=
BLB_DATABASE=blb

TRANSFER_HOST=
TRANSFER_PORT=3306
TRANSFER_USER=
TRANSFER_PASSWORD=
TRANSFER_DATABASE=transfer

TEACHERS=62,110,332
ACTIVITY_TYPE=Video

DEST_LIBRARY_ID=
DEST_API_KEY=
DEST_CDN_HOST=
DEST_COLLECTION_ID=
DEST_TOKEN_KEY=

SOURCE_LIBS=655017,670279,672957
SRC_655017_KEY=
SRC_655017_HOST=
SRC_655017_COLLECTION=
SRC_655017_TOKEN=

# GCS fallback (optional): fetch the original from a bucket when the Bunny source is gone/broken.
# Routes map a keyword in activities.video_source_path -> bucket -> service-account key file.
ENABLE_GCS_FALLBACK=false
GCS_ROUTES=blb:blb_2025:firbasesec.json,ashtar:ems-new:ashtar-a3c78-1cfaf78133a6.json
GCS_SIGNED_URL_TTL_HOURS=24
GCS_REOPEN_SKIPPED=true

CONCURRENCY=8
ENABLE_SOURCE_DELETE=false
ENABLE_DB_UPDATE=false
LIVE=false
POLL_INTERVAL_MS=20000
MAX_TRANSCODE_WAIT_MS=10800000
HTTP_TIMEOUT_MS=120000
MAX_ATTEMPTS=3
DASHBOARD_PORT=4545
